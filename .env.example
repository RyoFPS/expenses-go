# Salin ke .env lalu ganti semua placeholder. JANGAN commit .env.

# dev | prod
ENV=dev

# PostgreSQL (password: gunakan karakter URL-safe saja, mis. hasil `openssl rand -hex 24`)
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finance

# Kunci untuk endpoint ingest (header X-API-Key). Buat dengan `openssl rand -hex 32`.
API_KEY=change-me

# Hanya boleh true jika ENV=dev (melewati validasi Cloudflare Access di lokal).
AUTH_DISABLED=true

# Cloudflare Access: wajib jika AUTH_DISABLED=false (lihat docs/DEPLOY.md).
# Team domain mis. namatim.cloudflareaccess.com; AUD = "Application Audience (AUD) Tag" tiap aplikasi Access.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CF_ACCESS_INGEST_AUD=

# Token Cloudflare Tunnel (Zero Trust > Networks > Tunnels). Hanya untuk `--profile tunnel`.
CLOUDFLARE_TUNNEL_TOKEN=

# Backup harian (cron, zona Asia/Jakarta) dan retensi.
BACKUP_CRON=0 2 * * *
BACKUP_RETENTION_DAYS=14

API_PORT=8000
WEB_PORT=3000
LOG_LEVEL=INFO
